# Travel-Plan Environment Configuration
# Copy this file to .env and modify values as needed

# PostgreSQL
POSTGRES_USER=travel_admin  
POSTGRES_PASSWORD=travel_secret_2024

# Neo4j
NEO4J_PASSWORD=travel_neo4j_2024

# Redis
REDIS_PASSWORD=redis_secret_2024

# RabbitMQ
RABBITMQ_USER=travel_mq
RABBITMQ_PASSWORD=mq_secret_2024

# Vault
VAULT_TOKEN=travel-vault-token-2024

# JWT
JWT_SECRET=your-super-secret-jwt-key-that-should-be-at-least-256-bits-long

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=grafana_admin_2024

# Stripe (Test Mode)
STRIPE_API_KEY=sk_test_your_stripe_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal (Sandbox)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Application
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
